{
  "expo": {
    "name": "Fit One",
    "slug": "app-fitone",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "fitone",
    "userInterfaceStyle": "dark",
    "ios": {
      "icon": "./assets/images/icon.png",
      "bundleIdentifier": "br.com.fitonemanaus.app",
      "supportsTablet": false
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0A0A0A",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "br.com.fitonemanaus.app",
      "versionCode": 1
    },
    "web": {
      "output": "server",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0A0A0A",
          "image": "./assets/images/splash-logo.png",
          "imageWidth": 140
        }
      ],
      "expo-sharing",
      "expo-video",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "O Fit One usa sua localização só durante corrida e bike com GPS, para medir distância e ritmo e desenhar o percurso (que só você vê)."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "O Fit One usa suas fotos só quando você escolhe uma para o card do treino ou para a publicação na comunidade.",
          "cameraPermission": "O Fit One usa a câmera só quando você tira uma foto para a publicação na comunidade."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "O Fit One usa a câmera para ler o QR de check-in da academia e para fotos que você escolher publicar.",
          "recordAudioAndroid": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "backgroundColor": "#0A0A0A"
  }
}
